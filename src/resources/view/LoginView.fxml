<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="25.0" prefWidth="500" prefHeight="400"
      style="-fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.edu.g8.tallermecanico.controller.LoginController">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Sistema de Gestión - Taller Mecánico" 
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Label text="Seleccione su perfil para ingresar:" 
           style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

    <VBox spacing="15.0" alignment="CENTER" prefWidth="300">
        <Button text="👤 Cliente" prefWidth="250" prefHeight="45"
                style="-fx-font-size: 14px; -fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"
                onAction="#ingresarComoCliente"/>

        <Button text="🔧 Mecánico" prefWidth="250" prefHeight="45"
                style="-fx-font-size: 14px; -fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;"
                onAction="#ingresarComoMecanico"/>

        <Button text="💼 Gerente / Administrador" prefWidth="250" prefHeight="45"
                style="-fx-font-size: 14px; -fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"
                onAction="#ingresarComoGerente"/>
    </VBox>

</VBox>