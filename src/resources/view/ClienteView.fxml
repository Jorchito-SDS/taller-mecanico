<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" prefWidth="750" prefHeight="500" 
      xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml" 
      fx:controller="main.java.edu.g8.tallermecanico.controller.ClienteController">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="👤 Portal del Cliente" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text=" Volver al Menú Principal" onAction="#onVolverMenu" style="-fx-background-color: #7f8c8d; -fx-text-fill: white;"/>
    </HBox>

    <TabPane prefHeight="400" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <!-- PESTAÑA 1: MIS VEHÍCULOS -->
            <Tab text="🚗 Mis Vehículos">
                <content>
                    <VBox spacing="10">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                        <Label text="Mis Vehículos Registrados" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        
                        <TableView fx:id="tablaMisVehiculos" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="colPlaca" text="Placa" prefWidth="120"/>
                                <TableColumn fx:id="colMarca" text="Marca" prefWidth="140"/>
                                <TableColumn fx:id="colModelo" text="Modelo" prefWidth="140"/>
                                <TableColumn fx:id="colAnio" text="Año" prefWidth="90"/>
                                <TableColumn fx:id="colKilometraje" text="Kilometraje" prefWidth="120"/>
                            </columns>
                        </TableView>

                        <Label text="Registrar Nuevo Vehículo" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <HBox spacing="10">
                            <TextField fx:id="txtPlaca" promptText="Placa" prefWidth="110"/>
                            <TextField fx:id="txtMarca" promptText="Marca" prefWidth="120"/>
                            <TextField fx:id="txtModelo" promptText="Modelo" prefWidth="120"/>
                            <TextField fx:id="txtAnio" promptText="Año" prefWidth="80"/>
                            <TextField fx:id="txtKilometraje" promptText="Kilometraje" prefWidth="100"/>
                            <Button text="Guardar" onAction="#onGuardarVehiculo" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>

            <!-- PESTAÑA 2: ESTADO DE REPARACIÓN -->
            <Tab text="🔧 Estado de Reparación">
                <content>
                    <VBox spacing="12">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                        <Label text="Consultar Estado de Mi Vehículo" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Ingrese Placa:"/>
                            <TextField fx:id="txtBuscarPlaca" prefWidth="150"/>
                            <Button text="Buscar Orden" onAction="#onBuscarEstadoOrden" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                        </HBox>

                        <VBox spacing="8" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 15;">
                            <Label fx:id="lblEstadoActual" text="Estado: No consultado" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
                            <Label fx:id="lblDetalleOrden" text="Detalles del diagnóstico o avance del vehículo aparecerán aquí." wrapText="true"/>
                        </VBox>
                    </VBox>
                </content>
            </Tab>

            <!-- PESTAÑA 3: AGENDAR CITA -->
            <Tab text="📅 Agendar Cita">
                <content>
                    <VBox spacing="12">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                        <Label text="Agendar Turno de Revisión" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Seleccionar Vehículo (Placa):" prefWidth="180"/>
                            <TextField fx:id="txtPlacaCita" prefWidth="180"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Fecha de Mantenimiento:" prefWidth="180"/>
                            <DatePicker fx:id="dpFechaCita" prefWidth="180"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Motivo / Observaciones:" prefWidth="180"/>
                            <TextField fx:id="txtMotivoCita" prefWidth="300"/>
                        </HBox>

                        <Button text="Confirmar Cita" onAction="#onAgendarCita" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Label fx:id="lblMensajeCita" style="-fx-text-fill: green;"/>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>