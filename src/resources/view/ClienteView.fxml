<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" prefWidth="750" prefHeight="500" 
      xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml" 
      fx:controller="main.java.edu.g8.tallermecanico.controller.ClienteController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="👤 Portal del Cliente" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="Cerrar Sesión" onAction="#onCerrarSesion"/>
    </HBox>

    <TabPane prefHeight="420" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <Tab text="🚗 Mis Vehículos">
                <VBox spacing="10">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <HBox spacing="10">
                        <TextField fx:id="txtPlaca" promptText="Placa"/>
                        <TextField fx:id="txtMarca" promptText="Marca"/>
                        <TextField fx:id="txtModelo" promptText="Modelo"/>
                        <TextField fx:id="txtAnio" promptText="Año"/>
                        <Button text="Registrar" onAction="#onRegistrarVehiculo"/>
                    </HBox>
                    <TableView fx:id="tablaVehiculos" prefHeight="250">
                        <columns>
                            <TableColumn fx:id="colPlaca" text="Placa" prefWidth="120"/>
                            <TableColumn fx:id="colMarca" text="Marca" prefWidth="150"/>
                            <TableColumn fx:id="colModelo" text="Modelo" prefWidth="150"/>
                            <TableColumn fx:id="colAnio" text="Año" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <Tab text="🔧 Estado de Reparación">
                <VBox spacing="10">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <TableView fx:id="tablaOrdenes" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="colOrdenVehiculo" text="Vehículo" prefWidth="150"/>
                            <TableColumn fx:id="colOrdenEstado" text="Estado" prefWidth="150"/>
                            <TableColumn fx:id="colOrdenDiagnostico" text="Diagnóstico" prefWidth="250"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <Tab text="📅 Agendar Cita">
                <VBox spacing="15" alignment="TOP_LEFT">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <DatePicker fx:id="dpFechaCita" promptText="Seleccionar fecha"/>
                    <TextArea fx:id="txtMotivo" promptText="Motivo de la visita o falla detectada" prefRowCount="3"/>
                    <Button text="Confirmar Cita" onAction="#onAgendarCita"/>
                    <Label fx:id="lblMensajeCita" style="-fx-text-fill: green;"/>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>