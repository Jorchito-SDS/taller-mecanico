<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" fx:controller="main.java.edu.g8.tallermecanico.controller.ClienteController" 
      xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtFiltro" promptText="Buscar por nombre, teléfono o email..." HBox.hgrow="ALWAYS"/>
        <Button text="Buscar" onAction="#onBuscar" defaultButton="true"/>
    </HBox>

    <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150.0"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120.0"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="180.0"/>
            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="200.0"/>
        </columns>
    </TableView>

</VBox>