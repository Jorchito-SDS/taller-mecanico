<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="main.java.edu.g8.tallermecanico.controller.FacturaController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Generación de Facturas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="ID Orden:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtIdOrden" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Total (Q):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtTotal" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <Button text="Generar Factura" onAction="#handleGenerarFactura"/>
</VBox>
