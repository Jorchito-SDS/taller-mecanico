<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.edu.g8.tallermecanico.controller.OrdenesMecanicoController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Órdenes por Mecánico" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <ComboBox fx:id="cmbMecanico" prefWidth="280"/>
        <Button text="Ver órdenes" onAction="#onVerOrdenes"/>
    </HBox>

    <Label fx:id="lblMensaje" style="-fx-text-fill: green;"/>

    <TableView fx:id="tablaOrdenes" prefHeight="260">
        <columns>
            <TableColumn fx:id="colPlaca" text="Placa" prefWidth="100"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="150"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
            <TableColumn fx:id="colFechaRecepcion" text="Fecha recepción" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
