<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.edu.g8.tallermecanico.controller.OrdenesMecanicoController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="📊 Mis Órdenes Asignadas" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="Volver al Menú" onAction="#onVolverMenu" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <TableView fx:id="tablaOrdenesAsignadas" prefHeight="200">
        <columns>
            <TableColumn fx:id="colIdOrden" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colVehiculo" text="Vehículo" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
            <TableColumn fx:id="colDiagnostico" text="Diagnóstico" prefWidth="250"/>
        </columns>
    </TableView>

    <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
        <Label text="Actualizar Orden Selected" style="-fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ComboBox fx:id="cbNuevoEstado" promptText="Nuevo Estado" prefWidth="180"/>
            <Button text="Guardar Cambios" onAction="#onActualizarEstado" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            <Button text="Eliminar Orden" onAction="#onEliminarOrden" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
        </HBox>
        <TextArea fx:id="txtDiagnostico" promptText="Escriba el diagnóstico o notas técnicas..." prefHeight="80"/>
        <Label fx:id="lblMensaje" style="-fx-text-fill: #e74c3c;"/>
    </VBox>
</VBox>